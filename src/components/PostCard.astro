---
import type { CollectionEntry } from 'astro:content';
import { getEntries } from 'astro:content';
import { formatDate } from '../lib/formatDate';
import AuthorLine from './AuthorLine.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const authors = await getEntries(post.data.authors);
---

<article class="post-card">
  <h2 class="post-card__title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
  <p class="post-card__meta">
    <AuthorLine authors={authors} /> · <time datetime={post.data.pubDate.toISOString()}
      >{formatDate(post.data.pubDate)}</time
    >
  </p>
  <p class="post-card__excerpt">{post.data.excerpt}</p>
</article>

<style>
  .post-card + .post-card {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .post-card__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .post-card__title a {
    text-decoration: none;
    color: var(--color-ink);
  }

  .post-card__title a:hover {
    color: var(--color-accent);
  }

  .post-card__meta {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .post-card__excerpt {
    margin: var(--space-3) 0 0;
    max-width: var(--measure);
  }
</style>
