# Keystatic GitHub-mode storage (production, e.g. Vercel). Leave these empty for local dev —
# keystatic.config.ts falls back to local-mode storage (direct file writes, no login) whenever
# PUBLIC_KEYSTATIC_STORAGE isn't "github". See docs/TROUBLESHOOTING-GITHUB-KEYSTATIC.md for the
# full setup procedure and every failure mode we hit getting this working.

# Switches keystatic.config.ts's storage kind. Must be PUBLIC_-prefixed (not a secret) —
# this file is bundled into the browser too, and only PUBLIC_ vars are visible there;
# reading a bare KEYSTATIC_GITHUB_CLIENT_ID presence there crashed the admin UI with
# "process is not defined" (confirmed while building this).
PUBLIC_KEYSTATIC_STORAGE=

# The GitHub App's slug, e.g. "acme-keystatic". Not a secret: the admin UI uses it client-side to
# render an "install the app" link for users who don't have write access to the repo yet.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# These come from a **GitHub App** — NOT a classic OAuth App. A classic OAuth App logs in but
# cannot commit: saving fails with a GraphQL error saying the token was granted [''] scopes,
# because Keystatic never sends a `scope` parameter (GitHub Apps use installation permissions
# instead). Generate all four values with Keystatic's own wizard: run the dev server with
# PUBLIC_KEYSTATIC_STORAGE=github and open /keystatic/setup — it creates the App via GitHub's App
# Manifest flow and writes them here. Afterwards you must still INSTALL the App on the repo at
# https://github.com/apps/<slug>/installations/new — creating it grants no access on its own.
# A GitHub App client ID starts with "Iv23li"; an OAuth App's starts with "Ov23li".
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret Keystatic uses to encrypt the admin session cookie. Generate your own, e.g.
# `openssl rand -hex 32` — never reuse a value from an example or commit a real one. Rotating it
# invalidates every existing session, which is the clean way to force re-login after swapping
# credentials (a stale cookie keeps presenting the old app's token).
KEYSTATIC_SECRET=
