# Keystatic GitHub-mode storage (production, e.g. Vercel). Leave all four empty for local
# dev — keystatic.config.ts falls back to local-mode storage (direct file writes, no OAuth)
# whenever PUBLIC_KEYSTATIC_STORAGE isn't "github". See docs/EVAL-KEYSTATIC.md §7.

# Switches keystatic.config.ts's storage kind. Must be PUBLIC_-prefixed (not a secret) —
# this file is bundled into the browser too, and only PUBLIC_ vars are visible there;
# reading a bare KEYSTATIC_GITHUB_CLIENT_ID presence there crashed the admin UI with
# "process is not defined" (confirmed while building this).
PUBLIC_KEYSTATIC_STORAGE=

# KEYSTATIC_GITHUB_CLIENT_ID / KEYSTATIC_GITHUB_CLIENT_SECRET come from a GitHub OAuth App
# (https://github.com/settings/developers) whose callback URL is
# <your deployed origin>/api/keystatic/github/oauth/callback. These two stay server-only.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret Keystatic uses to encrypt the admin session cookie. Generate your own, e.g.
# `openssl rand -hex 32` — never reuse a value from an example or commit a real one.
KEYSTATIC_SECRET=
